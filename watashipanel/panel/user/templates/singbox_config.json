{
    // watashi v12.2.100: brought to the shape sing-box 1.13 and 1.14 accept.
    // the dns and block outbounds are removed cores, the address form of a
    // dns server is gone, the geoip rule was removed in 1.12 and the sniff
    // switch moved from the inbound into a route rule.
    "log": {
        "disabled": false,
        "level": "warn",
        "timestamp": false
    },
    "experimental": {
        "clash_api": {
            "external_controller": "127.0.0.1:9090"
        },
        "cache_file": {
            "enabled": true,
            "path": "clash.db",
            "store_fakeip": true
        }
    },
    "dns": {
        "servers": [
            {
                "type": "tcp",
                "tag": "dns-remote",
                "server": "1.1.1.1",
                "detour": "ssh-out"
            },
            {
                "type": "local",
                "tag": "dns-local"
            }
        ],
        "rules": [
            {
                "domain": [
                    "{{domain}}",
                    "github.com",
                    "githubusercontent.com",
                    "{{ssh_ip}}"
                ],
                "server": "dns-local"
            },
            {
                "domain_suffix": [
                    "ir"
                ],
                "server": "dns-local"
            }
        ],
        "final": "dns-remote",
        "strategy": "prefer_ipv4"
    },
    "inbounds": [
        {
            "listen": "127.0.0.1",
            "listen_port": 6450,
            "override_address": "8.8.8.8",
            "override_port": 53,
            "tag": "dns-in",
            "type": "direct"
        },
        {
            "type": "tun",
            "tag": "tun-in",
            "interface_name": "tun0",
            "address": ["172.19.0.1/30"],
            "mtu": 9000,
            "auto_route": true,
            "strict_route": true,
            "stack": "system",
            "endpoint_independent_nat": true
        },
        {
            "listen": "127.0.0.1",
            "listen_port": 2080,
            "tag": "mixed-in",
            "type": "mixed"
        }
    ],
    "outbounds": [
        {
            "type": "socks",
            "tag": "SSH+UDP",
            "server": "127.0.0.1",
            "server_port": 2000,
            "version": "5",
            "udp_over_tcp": true,
            "network": "tcp",
            "detour": "ssh-out"
        },
        {
            "type": "ssh",
            "tag": "ssh-out",
            //"client_version": "{{ssh_client_version}}",
            "server": "{{ssh_ip}}",
            "server_port": {{hconfigs[ConfigEnum.ssh_server_port]}},
            "user": "{{user.uuid}}",
            "private_key": "{{user.ed25519_private_key|replace('\n', '\\n')}}", //{{user.ed25519_public_key|replace('\n', '\\n')}}
            "host_key": {{host_keys}},
            "domain_resolver": "dns-local"
        },
        {
            "tag": "direct",
            "type": "direct",
            "domain_resolver": "dns-local"
        },
        {
            "tag": "bypass",
            "type": "direct",
            "domain_resolver": "dns-local"
        }
    ],
    "route": {
        "auto_detect_interface": true,
        "override_android_vpn": true,
        "final": "SSH+UDP",
        "default_domain_resolver": {
            "server": "dns-local"
        },
        "rules": [
            {
                "inbound": ["tun-in", "mixed-in"],
                "port": [
                    53
                ],
                "action": "hijack-dns"
            },
            {
                "inbound": [
                    "dns-in"
                ],
                "action": "hijack-dns"
            },
            {
                "inbound": ["tun-in", "mixed-in"],
                "action": "sniff",
                "timeout": "1s"
            },
            {
                "domain_suffix": [
                    "ir"
                ],
                "outbound": "bypass"
            },
            {
                "protocol": "quic",
                "port": [443],
                "action": "reject"
            },
            {
                "ip_cidr": [
                    "224.0.0.0/3",
                    "ff00::/8"
                ],
                "source_ip_cidr": [
                    "224.0.0.0/3",
                    "ff00::/8"
                ],
                "action": "reject"
            }
        ]
    }
}
