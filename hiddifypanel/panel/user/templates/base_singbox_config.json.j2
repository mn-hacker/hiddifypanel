{# watashi v12.2.100: this template used to carry three copies of every
   section, one for sing-box below 1.8, one below 1.10 and one below 1.11,
   because the old hiddify app was pinned to those cores. that app is not
   used any more, so the legacy halves are gone and what is left is the
   shape sing-box 1.13 and 1.14 accept: rule actions instead of block and
   dns outbounds, type based dns servers, an address list on the tun and
   the sniff decision taken in the route rules. #}
{
    "outbounds": [
        {
            "tag": "direct",
            "type": "direct",
            "domain_resolver": "dns-local"
        },
        {
            "tag": "bypass",
            "type": "direct",
            "domain_resolver": "dns-local"
        }
    ],
    "route": {
        "auto_detect_interface": true,
        "override_android_vpn": true,
        "final": "Select",
        {# watashi v12.2.100: the dns rule that read the chosen outbound is
           removed in 1.14. this is the field that replaces it: every outbound
           that has to turn a name into an address asks dns-local, which is
           what the outbound rule used to say. #}
        "default_domain_resolver": {
            "server": "dns-local"
        },
        "rule_set": [
            {%if 0 and hconfig(ConfigEnum.country) in ["ir","zh","ru"]%}
            {
                "tag": "geosite-{{hconfig(ConfigEnum.country)|replace('zh', 'cn')}}",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/hiddify/hiddify-geo/rule-set/country/geosite-{{hconfig(ConfigEnum.country)|replace('zh', 'cn')}}.srs",
                "download_detour": "Select"
            },
            {
                "tag": "geoip-{{hconfig(ConfigEnum.country)|replace('zh', 'cn')}}",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/hiddify/hiddify-geo/rule-set/country/geoip-{{hconfig(ConfigEnum.country)|replace('zh', 'cn')}}.srs",
                "download_detour": "Select"
            }
            {%endif%}
        ],
        "rules": [
            {
                "inbound": ["tun-in", "mixed-in"],
                "port": [53],
                "action": "hijack-dns"
            },
            {
                "inbound": ["dns-in"],
                "action": "hijack-dns"
            },
            {
                "inbound": ["tun-in", "mixed-in"],
                "action": "sniff",
                "timeout": "1s"
            },
            {%if 0 and hconfig(ConfigEnum.country) in ["ir","zh","ru"]%}
            {
                "rule_set": "geoip-{{hconfig(ConfigEnum.country)|replace('zh', 'cn')}}",
                "outbound": "bypass"
            },
            {
                "rule_set": "geosite-{{hconfig(ConfigEnum.country)|replace('zh', 'cn')}}",
                "outbound": "bypass"
            },
            {%endif%}
            {
                "protocol": "quic",
                "port": [
                    443
                ],
                "action": "reject"
            },
            {
                "ip_cidr": [
                    "224.0.0.0/3",
                    "ff00::/8"
                ],
                "source_ip_cidr": [
                    "224.0.0.0/3",
                    "ff00::/8"
                ],
                "action": "reject"
            }
        ]
    },
    "experimental": {
        "clash_api": {
            "external_controller": "127.0.0.1:9090",
            "external_ui_download_url": "https://github.com/MetaCubeX/Yacd-meta/archive/gh-pages.zip"
        },
        "cache_file": {
            "enabled": true,
            "path": "cache.db",
            "cache_id": "{{g.account.uuid}}",
            "store_fakeip": true
        }
    },
    "dns": {
        {# watashi v12.2.100: the address form of a dns server is removed in
           1.14. tcp://1.1.1.1 is written as a tcp server and the plain
           8.8.8.8 as a udp server, and address_resolver is not needed any
           more because both of them are addresses already. #}
        "servers": [
            {
                "type": "tcp",
                "tag": "dns-remote",
                "server": "1.1.1.1",
                "detour": "Select"
            },
            {
                "type": "udp",
                "tag": "dns-local",
                "server": "8.8.8.8",
                "detour": "direct"
            }
        ],
        "rules": [
            {
                "domain": [
                    "github.com",
                    "githubusercontent.com",
                    "raw.githubusercontent.com",
                    "1.1.1.1"
                ],
                "server": "dns-local"
            }
            {%if 0 and hconfig(ConfigEnum.country)in ["ir","zh","ru"]%}
            ,{
                "domain_suffix": [
                    "{{hconfig(ConfigEnum.country)|replace('zh', 'cn')}}"
                ],
                "server": "dns-local"
            }
            {%endif%}
        ],
        "final": "dns-local",
        "strategy": "prefer_ipv4"
    },
    "inbounds": [
        {
            "listen": "127.0.0.1",
            "listen_port": 6450,
            "override_address": "8.8.8.8",
            "override_port": 53,
            "tag": "dns-in",
            "type": "direct"
        },
        {
            "type": "tun",
            "tag": "tun-in",
            "interface_name": "tun0",
            "address": ["172.19.0.1/30"],
            "mtu": 9000,
            "auto_route": true,
            "strict_route": true,
            "stack": "system",
            "endpoint_independent_nat": true
        },
        {
            "listen": "127.0.0.1",
            "listen_port": 2334,
            "tag": "mixed-in",
            "type": "mixed"
        }
    ]
}
